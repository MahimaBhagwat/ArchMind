issues/
docs/

# ── Dependencies ─────────────────────────────────────────────────────
node_modules/

# ── Python virtualenv ────────────────────────────────────────────────
backend/venv/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
*.pyc
__pycache__/

