client/dist/

# ── Environment files (never commit secrets) ─────────────────────────
.env
.env.local
.env.*.local

# ── Logs ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS / editor ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Vite cache ────────────────────────────────────────────────────────
*.local

# ── Agent config (may contain API keys) ──────────────────────────────
.claude/
.gemini/

# ── Throwaway / debug artifacts ───────────────────────────────────────
_*
